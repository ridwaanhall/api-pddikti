# =============================================================================
# Environment configuration
#
# No host, upstream, or third-party URL is hardcoded in the source tree. Every
# value below is read at startup, so this repository can be published without
# disclosing which services the deployment talks to.
#
# Anything left blank simply disables the feature that needs it -- the app will
# still boot. Check GET /api/ to see what a running deployment actually
# resolved.
# =============================================================================

# --- Branding ----------------------------------------------------------------
# Everything user-facing (page titles, OpenAPI title, credit line, disclaimer)
# derives from these.
BRAND_NAME=Sivitas API
BRAND_OWNER=RoneAI
MAINTAINER=your-handle
BRAND_TAGLINE=Structured access to Indonesian higher-education data.
# Named in the attribution and the non-affiliation notice.
DATA_SOURCE_NAME=
# Optional overrides; both are generated from the values above when left blank.
CREDIT_LINE=
DISCLAIMER=

# --- Secrets -----------------------------------------------------------------
SECRET_KEY=your-secret-key-here
API_KEY=your-api-key
DEBUG=False

# --- Primary upstream (REQUIRED for the API to return data) ------------------
# UPSTREAM_BASE_URL   : base the entity paths are appended to
# UPSTREAM_ORIGIN     : origin/referer sent with upstream requests
# UPSTREAM_DECRYPT_URL: endpoint that exchanges an encrypted payload for JSON
UPSTREAM_ORIGIN=
UPSTREAM_BASE_URL=
UPSTREAM_DECRYPT_URL=

# --- Optional authenticated fallback -----------------------------------------
# Tried only when the primary upstream is unreachable. Leave
# RIDWAANHALL_MAIN_API blank to disable the fallback entirely.
RIDWAANHALL_MAIN_API=
RIDWAANHALL_API_X=
RIDWAANHALL_X=
RIDWAANHALL_HASH_X=
RIDWAANHALL_API_KEY=
RIDWAANHALL_KEY=
RIDWAANHALL_HASH_KEY=

# --- Caller IP forwarding ----------------------------------------------------
# The caller's own IP is forwarded upstream so the source sees the end user's
# location rather than the hosting platform's egress. This lookup is the
# fallback used only when the caller IP is not routable (e.g. local dev).
# Blank disables the lookup.
IP_LOOKUP_URL=
IP_CACHE_TTL=3600

# --- This service ------------------------------------------------------------
API_AVAILABILITY=True
API_VERSION=5.0.0
LAST_UPDATE=2026-08-29T00:00:00+07:00
# Request timeout in seconds. Keep under the platform's function limit.
API_TIMEOUT=10
# Canonical public URL of this deployment (used for canonical tags + sitemap).
PUBLIC_BASE_URL=

# Optional second deployment advertised when this one is rate-limited.
ALTERNATIVE_BASE_URL=
ALTERNATIVE_NAME=High Availability Endpoint

# --- Support links and web chrome (all optional) -----------------------------
SUPPORT_EMAIL=
SUPPORT_CHAT_URL=
SUPPORT_CONTACT_URL=
WEBSITE_URL=
FAVICON_URL=
# Google Analytics measurement ID. Blank means no analytics tag is emitted.
ANALYTICS_ID=
