# App Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
PUBLIC_BASE_URL=https://pddikti.rone.dev

# API Configuration
API_KEY=your-api-key

# Primary upstream: the public PDDikti web API. Needs no credentials -- the built-in
# defaults below are correct, so leave these unset unless PDDikti moves the host.
PDDIKTI_SITE_ORIGIN=https://pddikti.kemdiktisaintek.go.id
PDDIKTI_PUBLIC_BASE=https://pddikti.kemdiktisaintek.go.id/api
PDDIKTI_DECRYPT_URL=https://pddikti.kemdiktisaintek.go.id/internal/decrypt

# Public-IP lookup, used only when the caller's own IP is not routable (local dev).
IPIFY_URL=https://api.ipify.org/?format=json
IP_CACHE_TTL=3600

# Optional authenticated fallback, tried only when the primary upstream is unreachable.
# Leave RIDWAANHALL_MAIN_API empty to disable the fallback entirely.
# (set these in secure runtime env, not in public docs)
RIDWAANHALL_MAIN_API=
RIDWAANHALL_API_X=
RIDWAANHALL_X=
RIDWAANHALL_HASH_X=
RIDWAANHALL_API_KEY=
RIDWAANHALL_KEY=
RIDWAANHALL_HASH_KEY=

# API Timeout (in seconds, optimized for Vercel serverless functions)
# Default: 8 seconds (safe for Vercel Hobby 10s limit and Pro 60s limit)
API_TIMEOUT=8

# API Availability and metadata
API_AVAILABILITY=True
API_VERSION=4.0.0
LAST_UPDATE=2026-05-29T00:00:00+07:00

